9Z",fill:"white"})]}),fk=({className:e="h-[34px] w-[34px]",width:t=34,height:i=34})=>m.jsxs("svg",{className:e,width:t,height:i,viewBox:`0 0 ${t} `+i,fill:"none",xmlns:"http://www.w3.org/2000/svg",children:[m.jsx("circle",{cx:"17",cy:"17",r:"17",fill:"black",fillOpacity:"0.4"}),m.jsx("path",{d:"M16 8.16992C15.7651 8.17227 15.5385 8.25723 15.36 8.40992L10 12.9999H7C6.73478 12.9999 6.48043 13.1053 6.29289 13.2928C6.10536 13.4804 6 13.7347 6 13.9999V19.9999C6 20.2651 6.10536 20.5195 6.29289 20.707C6.48043 20.8946 6.73478 20.9999 7 20.9999H10L15.35 25.5899C15.4953 25.7142 15.6731 25.7942 15.8625 25.8205C16.0518 25.8468 16.2447 25.8182 16.4184 25.7383C16.592 25.6583 16.7391 25.5302 16.8421 25.3692C16.9452 25.2083 17 25.0211 17 24.8299V9.16992C17 8.90471 16.8946 8.65035 16.7071 8.46282C16.5196 8.27528 16.2652 8.16992 16 8.16992ZM15 22.6499L11.3 19.4799L10.74 18.9999H8V14.9999H10.74L11.3 14.5199L15 11.3499V22.6499Z",fill:"white"}),m.jsx("path",{d:"M20 9C19.7348 9 19.4804 9.10536 19.2929 9.29289C19.1054 9.48043 19 9.73478 19 10C19 10.2652 19.1054 10.5196 19.2929 10.7071C19.4804 10.8946 19.7348 11 20 11C21.5913 11 23.1174 11.6321 24.2426 12.7574C25.3679 13.8826 26 15.4087 26 17C26 18.5913 25.3679 20.1174 24.2426 21.2426C23.1174 22.3679 21.5913 23 20 23C19.7348 23 19.4804 23.1054 19.2929 23.2929C19.1054 23.4804 19 23.7348 19 24C19 24.2652 19.1054 24.5196 19.2929 24.7071C19.4804 24.8946 19.7348 25 20 25C22.1217 25 24.1566 24.1571 25.6569 22.6569C27.1571 21.1566 28 19.1217 28 17C28 14.8783 27.1571 12.8434 25.6569 11.3431C24.1566 9.84285 22.1217 9 20 9Z",fill:"white"}),m.jsx("path",{d:"M20 19C19.7348 19 19.4804 19.1054 19.2929 19.2929C19.1054 19.4804 19 19.7348 19 20C19 20.2652 19.1054 20.5196 19.2929 20.7071C19.4804 20.8946 19.7348 21 20 21C21.0609 21 22.0783 20.5786 22.8284 19.8284C23.5786 19.0783 24 18.0609 24 17C24 15.9391 23.5786 14.9217 22.8284 14.1716C22.0783 13.4214 21.0609 13 20 13C19.7348 13 19.4804 13.1054 19.2929 13.2929C19.1054 13.4804 19 13.7348 19 14C19 14.2652 19.1054 14.5196 19.2929 14.7071C19.4804 14.8946 19.7348 15 20 15C20.5304 15 21.0391 15.2107 21.4142 15.5858C21.7893 15.9609 22 16.4696 22 17C22 17.5304 21.7893 18.0391 21.4142 18.4142C21.0391 18.7893 20.5304 19 20 19Z",fill:"white"})]});var Ak,Ek,bk,yk,Ik,xk,Tk,Sk,Ck,Rk;let Ok=[{advertiser:"Vaportek",obfuscatedAdId:"A03152092T6Q82B7FB9TX",adId:"301027505955202",asin:"B0F4RRKG8X",backgroundColor:"#c4aa98",textColor:"#000000",transcriptText:"Today our AI generated shopping show is exploring the Vaportek Odor Eliminating Discs. Jordan, what makes this different from typical air fresheners? Well, the key difference is it uses a dry vapor system instead of liquid sprays or plug-in oils. The technology comes from a special non-woven fiber disc that's infused with natural eucalyptus and pine oils. It's actually quite clever how it works. So no batteries, no plugs, just passive scent distribution. Exactly, and that's what makes it so practical. You can adjust the vents to control the intensity, and each disk covers about 2000 cubic feet for a full month. Mm, that's interesting. What about placement options? The units come with hook and loop backing, so you can place them exactly where you need them, maybe in a laundry room, anywhere odors tend to collect. Who might want to look at other options instead? People who prefer stronger, more perfumed scents might want something different. This is more about neutralizing odors than creating an obvious fragrance. The neutral scent is very subtle and natural. And who do you think would love the Vaportek disks the most? This is perfect for people who want a low maintenance, set it and forget it solution, especially great for those who need to tackle odors at the source without overwhelming their spaces with artificial fragrances. Thanks for helping us clear the air on that one. I think we can all breathe a little easier now.",podcastAudioUrl:"https://d3ociwlx7pihh7.cloudfront.net/ads-experiment/ATVPDKIKX0DER/en_US/B0F4RRKG8X/shoptalk_podcast.mp3",podcastSubtitlesUrl:"https://d3ociwlx7pihh7.cloudfront.net/ads-experiment/ATVPDKIKX0DER/en_US/B0F4RRKG8X/subtitles.vtt"},{advertiser:"Polygel",obfuscatedAdId:"A05249941IRLNKDCKCHDB",adId:"301031055022702",asin:"B008A6M34C",backgroundColor:"#44436B",textColor:"#ffffff",transcriptText:"Today our AI generated shopping show is exploring the FlexiKold Gel Cold Pack. I've heard a lot about these therapeutic compresses lately. What makes this one special? The standout feature is their proprietary gel interior that stays cold longer than typical ice packs while remaining flexible when frozen. That flexibility is crucial. It lets you wrap it around joints like knees or elbows effectively. Oh, interesting. So it's not like those rigid ice packs that just sit there. Exactly. The double-sealed seams and thick nylon exterior make it durable, but it still molds to your body. Customers report it stays cold for over 20 minutes and is particularly effective for knee and back pain relief. What about size? Is this meant for specific body parts? The medium size is 7.5 by 11.5 inches, which customers say is perfect for covering larger areas like the back, but it's versatile enough for smaller zones too. You can use it for everything from wisdom teeth recovery to plantar fasciitis. Who might want to look at different options? If someone needs targeted therapy for very small areas like fingers or toes, they might prefer a smaller compress. Also, this doesn't come with straps, so if hands-free use is important, there are other options with built-in wraps. Final thoughts on who this FlexiKold Pack is perfect for. It's ideal for anyone dealing with muscle recovery, post-surgery healing, or chronic pain who wants a reliable, long-lasting cold therapy solution. The combination of flexibility and coverage area makes it especially valuable for active people treating sports injuries. Well, that certainly puts this cold pack in a different light. Thanks for helping us chill out today.",podcastAudioUrl:"https://d3ociwlx7pihh7.cloudfront.net/ads-experiment/ATVPDKIKX0DER/en_US/B008A6M34C/shoptalk_podcast.mp3",podcastSubtitlesUrl:"https://d3ociwlx7pihh7.cloudfront.net/ads-experiment/ATVPDKIKX0DER/en_US/B008A6M34C/subtitles.vtt"},{advertiser:"James 1",obfuscatedAdId:"A0596805ATI6SMWO27NQ",adId:"301039820003202",asin:"B0DVFWF573",backgroundColor:"#e9e8c0",textColor:"#000000",transcriptText:"Today, our AI generated shopping show is exploring The Patch Remedy happy patch. These wellness patches are getting attention, but what makes them different from traditional supplements? Well, the biggest innovation here is the delivery method. Instead of pills or powders, you're getting nutrients through a patch that stays on your skin for up to 12 hours. It's basically like a vitamin sticker. That's interesting. What exactly is in these patches? They've combined some really thoughtful ingredients. You've got 5 HTP and L-theanine, which are often used for relaxation, plus adaptogenic herbs like rodeola and essential vitamins like B6 and D3. It's a comprehensive blend targeting overall wellness. I imagine some people might be skeptical about getting vitamins through a patch. How does that actually work? The patch uses extended release technology to gradually deliver the ingredients through your skin throughout the day. It's similar to how nicotine patches work just with different compounds. The waterproof design means you can wear it during exercise or in the shower. Who would you say these patches are best suited for? They're ideal for people who struggle with traditional supplements. Maybe they don't like swallowing pills or they forget to take them regularly. They're also great for busy folks who want a simple, mess-free option they can apply once and forget about for the day. And who might want to look at other options. People who prefer precise dosage control might want to stick with traditional supplements. Also, if you have sensitive skin or adhesive allergies, you'll want to be cautious with any patch-based product. Thanks for helping us understand the Patch Remedy patches. Sounds like they could be a game changer for the right person, especially if you're tired of juggling bottles of vitamins.",podcastAudioUrl:"https://d3ociwlx7pihh7.cloudfront.net/ads-experiment/ATVPDKIKX0DER/en_US/B0DVFWF573/shoptalk_podcast.mp3",podcastSubtitlesUrl:"https://d3ociwlx7pihh7.cloudfront.net/ads-experiment/ATVPDKIKX0DER/en_US/B0DVFWF573/subtitles.vtt"},{advertiser:"Rock-it-surf",obfuscatedAdId:"A098223980GM78HO7ES5",adId:"301023906900602",asin:"B07DVST88H",backgroundColor:"#6fbdd7",textColor:"#000000",transcriptText:"Today, our AI generated shopping show is exploring the Rock-It 4'10\" CHUB soft top surfboard. We've got a surf gear expert with us. What makes this board special for young riders? Well, this board is really designed with young surfers in mind. At just under 5ft long with a twin fin setup, it's super stable and easy to maneuver. What's interesting is they've built it with two wooden stringers coated in epoxy nano coating, which helps prevent water damage. Oh, interesting. And I noticed something unique about the bottom design. Yes, they've actually incorporated zebra stripes on the bottom based on some fascinating research from the University of Western Australia. The pattern is thought to deter sharks by making the board harder for them to identify as prey. While there's no guarantee, it's a thoughtful safety feature. That's quite innovative. How do we know if this board is right for someone? Based on its specs, it's ideal for riders up to 150 pounds. Customers report it's particularly good for young kids. One specifically mentioned it being perfect for their 7 year old. The soft top material means you don't even need wax, though you can add some for extra grip. And what about durability? That's always a concern with kids' equipment. According to customer feedback, it's quite durable, though, like any surfboard, you'll want to avoid rocks. What's also worth noting is their commitment to environmental responsibility. They use collected rainwater in manufacturing and avoid harmful chemicals in production. Thanks for breaking that down. Sounds like the Rock-It CHUB is perfect for young surfers getting their first taste of catching waves.",podcastAudioUrl:"https://d3ociwlx7pihh7.cloudfront.net/ads-experiment/ATVPDKIKX0DER/en_US/B07DVST88H/shoptalk_podcast.mp3",podcastSubtitlesUrl:"https://d3ociwlx7pihh7.cloudfront.net/ads-experiment/ATVPDKIKX0DER/en_US/B07DVST88H/subtitles.vtt"},{advertiser:"Jim and Jose",obfuscatedAdId:"A07939901F79PXNEMR145",adId:"301029216636102",asin:"B0FMYKT11S",backgroundColor:"#d5c7be",textColor:"#000000",transcriptText:"Today, our AI generated shopping show is exploring the Buffalo Broom Company pumpkin spice scented broom. Paisley, what makes this more than just a typical broom? Oh, this is such an interesting fusion of function and aesthetics. It's a 36 inch decorative piece that's actually crafted from heather wood and bound with jute rope. The really unique part is that it's hand dipped in pumpkin spice oils right here in the USA. Wait, pumpkin spice scented, how long does that last? Well, the scent will naturally fade over time, but here's the clever part. You can refresh it yourself with a few drops of pumpkin spice oil. It's designed to be both decorative and aromatic throughout the seasons. I'm curious about the traditional aspect you mentioned. What's the story there? Historically, brooms were hung by doorways to ward off negative energy. This design really honors that tradition while adding a modern twist with the seasonal scent. The natural heather twigs are specifically chosen to minimize shedding, which is important for a decorative piece. Who would you say this isn't the right fit for? If you're looking for a practical cleaning tool, this isn't it. It's purely decorative, perfect for hanging on doors or walls, and if you're sensitive to fragrances, you might want to consider their unscented options instead. So who's the ideal customer for the Buffalo Broom pumpkin spice broom? This is perfect for someone who loves creating seasonal displays and appreciates handcrafted decor with a story. It's especially great for those who enjoy bringing traditional elements into their modern home, and of course anyone who can't get enough of that cozy fall atmosphere. Well, that sweeps up our discussion for today. Thanks for helping us brush up on this festive piece.",podcastAudioUrl:"https://d3ociwlx7pihh7.cloudfront.net/ads-experiment/ATVPDKIKX0DER/en_US/B0FMYKT11S/shoptalk_podcast.mp3",podcastSubtitlesUrl:"https://d3ociwlx7pihh7.cloudfront.net/ads-experiment/ATVPDKIKX0DER/en_US/B0FMYKT11S/subtitles.vtt"},{advertiser:"Julien 1",obfuscatedAdId:"A09844592J4D4Y26TW0DE",adId:"301033986730102",asin:"B093TF3SZW",backgroundColor:"#a2ccc6",textColor:"#000000",transcriptText:"Today our AI generated shopping show is exploring Macuhealth Omega 3 Fish Oil supplements. We're joined by a wellness expert to learn more about this triple strength formula. So what makes this one special? Well, this supplement really stands out because of its high potency. Each serving packs 2200 mg of omega 3s, with equal amounts of DHA and EPA at 1100 mg each. That's significantly higher than many standard fish oils on the market. Oh, interesting. And what does that mean for someone taking it? The higher concentration means you're getting more of the beneficial compounds in each dose. Plus, customers report it's easy to swallow and this is key with fish oil. There's no fishy taste or smell, which can be a deal breaker for many people. You know, I always hear about omega 3s, but what exactly are they good for? They're primarily known for supporting heart health, but this formula is specifically designed with eye and brain health in mind. According to reviews, customers who've been recommended this by their optometrists are seeing positive results, particularly those with dry eyes. Are there any drawbacks people should know about? The main consideration is the price point. It's positioned as a premium product, and customer opinions on the value are mixed. Some feel it's worth every penny, while others find it a bit steep, but you're paying for quality ingredients in that higher concentration. And who would you say this is perfect for? This is ideal for people who are serious about their omega 3 supplementation, especially those focused on eye health. The high potency and quality ingredients make it particularly suitable for those who've found standard fish oil supplements aren't quite meeting their needs. Thanks for helping us dive deep into the world of Macuhealth Triple Strength Omega 3s. Sounds like these supplements could be the perfect catch for the right customer.",podcastAudioUrl:"https://d3ociwlx7pihh7.cloudfront.net/ads-experiment/ATVPDKIKX0DER/en_US/B093TF3SZW/shoptalk_podcast.mp3",podcastSubtitlesUrl:"https://d3ociwlx7pihh7.cloudfront.net/ads-experiment/ATVPDKIKX0DER/en_US/B093TF3SZW/subtitles.vtt"},{advertiser:"Trellis 1",obfuscatedAdId:"A00480371GNJAVPSI0RXY",adId:"301044003192202",asin:"B00XIFWON0",backgroundColor:"#78886a",textColor:"#000000",transcriptText:"Today, our AI generated shopping show is exploring the GEARit Cat 6 Ethernet cable pack. Christopher, what makes this 24 pack of network cables special? Well, these are really interesting because they're future-proofed for 10 gigabit networks, which is way beyond what most home users need right now. The gold plated connectors and 550 megahertz bandwidth rating mean they'll handle pretty much any networking task you throw at them. I hear a lot about different categories of Ethernet cables. What's the advantage of Cat 6? Cat 6 is like the sweet spot for most users. It supports faster speeds than the older Cat 5E, and these particular cables are verified to meet all the industry standards. They work with everything from basic internet connections to advanced stuff like power over Ethernet and even HDMI over Ethernet. Speaking of customer experiences, what are people saying about these cables? According to reviews, customers are finding good value here, especially for short cable runs. They're reporting success with POA camera systems. Though interestingly, some mention the connectors can be a bit tough to disconnect, which could be seen as a mixed blessing if you're looking for secure connections. Who would you say is the ideal user for this GEARit Cable Pack? This pack is perfect for someone setting up a home office or small business network. If you've got multiple devices to connect computers, printers, security cameras, and you want reliable, future-proof connections without breaking the bank, this is your answer. Though if you need longer cables or outdoor installation, you might want to look at other options. Thanks, Christopher. Sounds like these cables are ready to handle whatever the future of networking throws at them. And hey, at least you won't have to worry about them falling out.",podcastAudioUrl:"https://d3ociwlx7pihh7.cloudfront.net/ads-experiment/ATVPDKIKX0DER/en_US/B00XIFWON0/shoptalk_podcast.mp3",podcastSubtitlesUrl:"https://d3ociwlx7pihh7.cloudfront.net/ads-experiment/ATVPDKIKX0DER/en_US/B00XIFWON0/subtitles.vtt"},{advertiser:"Trellis 2",obfuscatedAdId:"A02996899XOXGEBMMIJF",adId:"301043986163602",asin:"B0DM6QB16D",backgroundColor:"#6aa4c1",textColor:"#000000",transcriptText:"Today, our AI generated shopping show is exploring the Dr. Tobias Colon Cleanse supplement. Max, what makes this product stand out in the crowded detox market? The key difference here is the comprehensive blend of natural ingredients. We're looking at a formula that combines traditional herbs like cascara, Sagrada, and Senna leaf with modern elements like probiotics. It's really a holistic approach to gut health. Oh, interesting. So what exactly should people expect when taking this? Well, it's designed as a 14-day program to help reset digestive function. The blend works to support regular elimination and help clear built up waste. From customer feedback, many report feeling more energized and noting improvements in their sleep patterns. I'm hearing some mixed experiences though. Yes, that's important to address. While many customers report positive results with bloating and constipation relief, others have noted experiencing stomach discomfort. This is actually common with cleanse products, which is why we always recommend starting slowly and listening to your body. Who would you say this product is best suited for? This is ideal for someone looking for a short-term digestive reset who's willing to commit to the full 14-day program, but I'd suggest that anyone with sensitive digestion or existing gut issues should consult their healthcare provider first. It's a powerful formula that deserves respect. Thanks, Max. Sounds like the Dr. Tobias Colon Cleanse could be just the reset some folks need, as long as they're ready for its potency. Just maybe don't plan any long road trips during those two weeks, if you know what I mean.",podcastAudioUrl:"https://d3ociwlx7pihh7.cloudfront.net/ads-experiment/ATVPDKIKX0DER/en_US/B0DM6QB16D/shoptalk_podcast.mp3",podcastSubtitlesUrl:"https://d3ociwlx7pihh7.cloudfront.net/ads-experiment/ATVPDKIKX0DER/en_US/B0DM6QB16D/subtitles.vtt"},{advertiser:"Julien 2",obfuscatedAdId:"A03561932O8WJ2WVOZSEK",adId:"301039737432202",asin:"B00ZO4WW7Q",backgroundColor:"#d1bfbb",textColor:"#000000",transcriptText:"Today our AI generated shopping show is exploring Copper Compression Arthritis Gloves. I'm curious, what makes these different from regular compression gloves. These gloves are really interesting because they combine copper infused fibers with targeted compression. The fingerless design lets people keep their dexterity while getting support where they need it most, in the palm, knuckles, and wrist area. How do people typically use them? They're designed for anyone dealing with hand discomfort, particularly from conditions like arthritis or carpal tunnel. The moisture wicking fabric means you can wear them all day, whether you're typing, crafting, or just going about daily activities. Hm. What are customers saying about them? Well, customers report mixed experiences. Many find them helpful for pain relief, especially with arthritis symptoms. However, there are varying opinions about the compression level. Some say it's just right, while others mention it's too tight on the wrist, and durability seems to be a concern with some reporting issues with the seams. Who would you say these are perfect for? These are best suited for someone looking for moderate hand support who needs to maintain finger mobility, think crafters, office workers, or anyone dealing with mild to moderate hand discomfort. But if someone needs serious medical grade compression, they might want to explore other options. Thanks for breaking that down for us. So, if you're looking to try the Copper Compression Gloves, just remember to measure your hand carefully for the right fit.",podcastAudioUrl:"https://d3ociwlx7pihh7.cloudfront.net/ads-experiment/ATVPDKIKX0DER/en_US/B00ZO4WW7Q/shoptalk_podcast.mp3",podcastSubtitlesUrl:"https://d3ociwlx7pihh7.cloudfront.net/ads-experiment/ATVPDKIKX0DER/en_US/B00ZO4WW7Q/subtitles.vtt"}],Dk={height:"100%",display:"flex"},wk={flex:3,color:"black",lineHeight:"18px",fontSize:13,fontStyle:"Amazon Ember",padding:7,paddingLeft:0,paddingRight:0,fontWeight:600},Lk={flex:2,margin:4,borderRadius:4,backgroundColor:"white",display:"flex",maxWidth:156,minWidth:146},Pk={width:32,minWidth:32,padding:2,display:"flex",alignItems:"center"},Mk={width:"100%"},Nk={display:"flex",flex:1,flexDirection:"column",maxWidth:"100%",overflow:"hidden",justifyContent:"center"},kk={fontSize:10,marginBottom:6,color:"black",whiteSpace:"nowrap",overflow:"hidden",textOverflow:"ellipsis"},Bk={height:"100%",overflow:"hidden"},Gk={visibility:"hidden",height:0,widt